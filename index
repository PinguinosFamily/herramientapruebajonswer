        // --- 2. LÓGICA DE LA INTERFAZ DE LA MATRIZ (ACORDEONES) ---
        const tabs = document.querySelectorAll('.matriz-tab');
        const matrixContainer = document.getElementById('matrix-container');
        const titleEl = document.getElementById('table-title');
        const badgeEl = document.getElementById('table-header-badge');

        function renderMatrix(key) {
            const data = dataMatriz[key];
            
            // Textos Cabecera
            titleEl.textContent = data.title;
            badgeEl.className = `flex items-center space-x-2 text-xs font-bold border border-slate-200 px-3 py-1.5 rounded-lg shadow-sm ${data.badgeColor}`;
