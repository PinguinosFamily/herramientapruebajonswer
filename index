        // --- 3. LÓGICA DEL SLIDER HORIZONTAL ---
        let currentSlide = 0;
        const totalSlides = 4;
        const sliderWrapper = document.getElementById('slider');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const headerNavs = document.querySelectorAll('.nav-btn');

        function updateSlider() {
            // Desplazamiento basado en Viewport Width (100vw por slide)
            sliderWrapper.style.transform = `translateX(-${currentSlide * 100}vw)`;
            
            prevBtn.disabled = currentSlide === 0;
            nextBtn.disabled = currentSlide === totalSlides - 1;

            headerNavs.forEach((btn, index) => {
                if(index === currentSlide) {
                    btn.classList.add('active');
                    btn.classList.replace('text-slate-500', 'text-brand-red');
                } else {
                    btn.classList.remove('active');
                    btn.classList.replace('text-brand-red', 'text-slate-500');
                }
            });
        }

        // Asignación de Eventos
        prevBtn.addEventListener('click', () => { if (currentSlide > 0) { currentSlide--; updateSlider(); } });
        nextBtn.addEventListener('click', () => { if (currentSlide < totalSlides - 1) { currentSlide++; updateSlider(); } });
        
        headerNavs.forEach(btn => {
            btn.addEventListener('click', (e) => {
                currentSlide = parseInt(e.currentTarget.dataset.index);
                updateSlider();
            });
        });

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                renderMatrix(tab.dataset.target);
            });
        });

        // Inicialización de la aplicación
        updateSlider();
        renderMatrix('solucion');

    </script>
