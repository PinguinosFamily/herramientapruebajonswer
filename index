                const detailsDiv = itemDiv.querySelector('.matrix-details');
                
                headerBtn.addEventListener('click', () => {
                    // Cierra los demás
                    const allDetails = matrixContainer.querySelectorAll('.matrix-details');
                    const allHeaders = matrixContainer.querySelectorAll('.matrix-row-header');
                    
