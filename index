            // Limpiar e Inyectar Acordeones
            matrixContainer.innerHTML = '';
            
            data.items.forEach((row, index) => {
                // Badge de Criticidad
                let criticBadge = '';
                if (key === 'inaceptables') {
                    criticBadge = `<span class="px-2 py-0.5 rounded text-3xs font-black uppercase tracking-wider bg-red-100 text-red-700 border border-red-200">FALTA CRÍTICA</span>`;
                } else if (row.critical) {
                    criticBadge = `<span class="px-2 py-0.5 rounded text-3xs font-black uppercase tracking-wider bg-amber-100 text-amber-700 border border-amber-200">CRÍTICO</span>`;
                } else {
                    criticBadge = `<span class="px-2 py-0.5 rounded text-3xs font-black uppercase tracking-wider bg-slate-100 text-slate-500 border border-slate-200">NO CRÍTICO</span>`;
                }

                // Color del título
                const titleColor = key === 'inaceptables' ? 'text-red-700' : 'text-slate-800';

                // Construcción del elemento DOM
                const itemDiv = document.createElement('div');
                itemDiv.className = 'border border-slate-200 rounded-xl overflow-hidden bg-white';
                
                itemDiv.innerHTML = `
                    <div class="matrix-row-header p-4 flex justify-between items-center bg-white border-b border-transparent">
                        <div class="flex items-center gap-4">
                            <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-400 shrink-0">${index + 1}</div>
                            <div>
                                <h4 class="font-bold ${titleColor} text-sm flex items-center gap-2">
                                    ${row.item} ${criticBadge}
                                </h4>
                                <p class="text-xs text-slate-500 mt-1">${row.desc}</p>
                            </div>
                        </div>
                        <div class="text-slate-400 rotate-icon shrink-0 ml-4">
                            <i class="fa-solid fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="matrix-details bg-slate-50">
                        <div class="p-4 border-t border-slate-100 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                            <div class="space-y-1.5 p-3 rounded-lg bg-emerald-50/50 border border-emerald-100">
                                <div class="font-bold text-emerald-700 flex items-center"><i class="fa-solid fa-check-circle mr-1.5"></i>Criterio Cumple</div>
                                <p class="text-slate-700 leading-relaxed">${row.cumple}</p>
                            </div>
                            <div class="space-y-1.5 p-3 rounded-lg bg-red-50/50 border border-red-100">
                                <div class="font-bold text-red-700 flex items-center"><i class="fa-solid fa-xmark-circle mr-1.5"></i>Criterio No Cumple</div>
                                <p class="text-slate-700 leading-relaxed">${row.nocumple}</p>
