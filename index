                    else if(key === 'tiempos') { tab.classList.add('border-sky-500', 'bg-sky-50'); titleDiv.className = 'text-sm font-bold text-sky-900 transition tab-title'; badgeSpan.className = 'tab-badge bg-sky-500 text-white text-xs font-black px-2 py-1 rounded';}
                    else if(key === 'emociones') { tab.classList.add('border-emerald-500', 'bg-emerald-50'); titleDiv.className = 'text-sm font-bold text-emerald-900 transition tab-title'; badgeSpan.className = 'tab-badge bg-emerald-500 text-white text-xs font-black px-2 py-1 rounded';}
